# Application Configuration
PROJECT_NAME="ATLAS Enterprise Hybrid RAG"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Configuration (Local & Supabase Cloud)
POSTGRES_USER="atlas_user"
POSTGRES_PASSWORD="atlas_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="atlas_db"
DATABASE_URL=""

# Qdrant Vector Search Engine (Local & Cloud)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=""
QDRANT_API_KEY=""

# Redis Cache & Message Broker (Local & Upstash Cloud)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Configuration (OpenRouter Free Tier Default)
LLM_PROVIDER="openrouter"
LLM_API_KEY=""
LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

